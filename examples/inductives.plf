inductive True: Type
    unit: True

inductive Nat: Type
    Z: Nat
    S: Nat -> Nat

inductive Bot: Nat -> Type

inductive BTree: Type
    Leaf: BTree
    Node: BTree -> BTree -> Nat -> BTree

id: Type -> Type := fun x -> x

axiom Prop: id Type

pred := Nat.ind (fun _ -> Nat) Z (fun n _ -> n)
label := BTree.ind (fun _ -> Nat) Z (fun _ _ _ _ i -> i)
one := label (Node Leaf Leaf (S Z))

print one
print Nat.ind
